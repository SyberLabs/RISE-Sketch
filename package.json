{
  "name": "rise-sketch",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Rise: living procedural ink. Your stroke is the seed.",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "build:single": "vite build --mode single",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.pure.json && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "e2e": "node scripts/e2e.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "puppeteer-core": "^25.12.0",
    "typescript": "^5.9.0",
    "vite": "^8.3.2",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^5.0.3"
  }
}
