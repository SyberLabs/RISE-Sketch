// Cloudflare Workers static-assets deploy for sketch.syberlabs.io.
// No Worker script: Cloudflare serves the Vite build in ./dist directly.
// `name` must match the Cloudflare project name.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rise-sketch",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  // Branch and pull-request previews (Workers Builds runs `npx wrangler preview` on non-production
  // branches, which refuses to run without this block).
  "previews": {}
}
